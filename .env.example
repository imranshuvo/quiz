APP_NAME="Quiz SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — production target is MySQL 8 / 9. SQLite is fine for early dev.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quiz_saas
DB_USERNAME=root
DB_PASSWORD=

# Use this block instead for SQLite local dev:
# DB_CONNECTION=sqlite

# -----------------------------------------------------------------------------
# Sessions / cache / queue
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=redis
HORIZON_PREFIX=quiz_saas_horizon:

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Broadcasting (live polls) — Reverb is Laravel's first-party websocket server.
# Reverb speaks the Pusher protocol so we expose it as PUSHER_* for the JS SDK.
# -----------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=quiz-saas
REVERB_APP_KEY=quiz-saas-key
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Filesystem (S3 used for response uploads & generated PDFs in production)
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-north-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Stripe (Cashier) — per-workspace subscriptions + metered AI usage.
# -----------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=da_DK

# -----------------------------------------------------------------------------
# AI providers — we use Prism PHP to abstract over multiple vendors.
# Set the keys for whichever providers you want to enable in config/prism.php.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

OLLAMA_URL=http://localhost:11434

# Default provider/model the app reaches for when no explicit override.
PRISM_DEFAULT_PROVIDER=anthropic
PRISM_DEFAULT_MODEL=claude-sonnet-4-6

VITE_APP_NAME="${APP_NAME}"
